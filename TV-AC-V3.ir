Filetype: IR library file
Version: 1
# ==========================================
# УНИВЕРСАЛЬНЫЙ ПУЛЬТ
# ==========================================
# Все сигналы сгруппированы по универсальным именам кнопок.
# При нажатии кнопки Flipper Zero будет перебирать все сигналы с этим именем,
# начиная с самых популярных брендов:
# 1. Samsung
# 2. LG
# 3. SberTV (Салют ТВ)
# 4. Haier
# 5. TCL
# 6. Panasonic
# 7. Xiaomi
# 8. Philips
# 9. Hisense
# 10. Medion
# ==========================================

